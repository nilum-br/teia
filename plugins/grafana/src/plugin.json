{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "panel",
  "name": "teia",
  "id": "nilum-teia-panel",
  "info": {
    "keywords": [
      "service map",
      "dependency graph",
      "topology",
      "observability",
      "opentelemetry",
      "istio",
      "backstage",
      "network"
    ],
    "description": "Who talks to whom, compared with what teams declared: live communication map with health, drift and blind spots.",
    "author": {
      "name": "Nilum",
      "url": "https://nilum.com.br"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      {
        "name": "Website",
        "url": "https://github.com/nilum-br/teia"
      },
      {
        "name": "License",
        "url": "https://github.com/nilum-br/teia/blob/main/LICENSE"
      }
    ],
    "screenshots": [
      { "name": "The communication map in a dashboard", "path": "img/screenshot-panel.png" },
      { "name": "Details and the next step to see more", "path": "img/screenshot-details.png" }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "dependencies": {
    "grafanaDependency": ">=13.2.0",
    "plugins": []
  }
}
