{
  "name": "nilum-teia-panel",
  "version": "0.1.0",
  "scripts": {
    "sync-ui": "node scripts/sync-ui.mjs",
    "build": "node scripts/sync-ui.mjs && webpack -c ./webpack.config.ts --env production",
    "dev": "node scripts/sync-ui.mjs && webpack -w -c ./webpack.config.ts --env development",
    "test": "jest --watch --onlyChanged",
    "test:ci": "node scripts/sync-ui.mjs && npm run test:deps && jest --passWithNoTests --maxWorkers 4",
    "typecheck": "node scripts/sync-ui.mjs && tsc --noEmit",
    "lint": "node scripts/sync-ui.mjs && eslint --cache .",
    "lint:fix": "npm run lint -- --fix && prettier --write --list-different .",
    "e2e": "playwright test",
    "deps:check": "node scripts/check-dependencies.mjs",
    "deps:audit": "npm audit --audit-level=low",
    "test:deps": "node --test scripts/dependency-regressions.test.mjs",
    "server": "docker compose up --build",
    "sign": "sign-plugin"
  },
  "author": "Nilum",
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint-react/eslint-plugin": "^5.27.1",
    "@grafana/sign-plugin": "^3.3.3",
    "@grafana/tsconfig": "^2.2.0",
    "@playwright/test": "^1.64.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/core": "^1.16.18",
    "@swc/helpers": "^0.5.23",
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.3.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "glob": "^13.0.6",
    "globals": "^17.13.0",
    "identity-obj-proxy": "^3.0.0",
    "imports-loader": "^5.0.0",
    "intersection-observer": "^0.12.2",
    "jest": "^30.5.2",
    "jest-canvas-mock": "^2.5.8",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.9.10",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "sass": "^1.105.1",
    "sass-loader": "^17.0.1",
    "semver": "^7.8.5",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.7",
    "terser-webpack-plugin": "^5.6.1",
    "ts-node": "^10.9.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-subresource-integrity": "^5.1.0",
    "webpack-virtual-modules": "^0.6.2"
  },
  "engines": {
    "node": ">=26.12.0 <27"
  },
  "dependencies": {
    "@grafana/data": "13.2.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "packageManager": "npm@12.2.0",
  "description": "teia communication map for Grafana: declared vs observed, health, blind spots, live.",
  "overrides": {
    "get-uri": {
      "basic-ftp": "6.2.3"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "5.4.3"
    }
  }
}
