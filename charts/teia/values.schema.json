{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "teia chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": { "type": "object" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "config": {
      "description": "teia.yaml, as in docs/configuration.md. teia itself rejects unknown keys at startup.",
      "type": "object",
      "properties": {
        "listen": { "not": {}, "description": "Set by the chart: the container listens on 8080." },
        "sources": {
          "type": "object",
          "properties": {
            "declared": { "not": {}, "description": "Set by the chart from flows and flowsConfigMap." }
          }
        }
      }
    },
    "flows": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z0-9._-]+\\.ya?ml$" },
      "additionalProperties": { "type": "string" }
    },
    "flowsConfigMap": { "type": "string" },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": { "type": "string" },
        "token": { "type": "string", "pattern": "^[A-Za-z0-9_-]*$" }
      }
    },
    "env": { "type": "array" },
    "envFrom": { "type": "array" },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "create": { "type": "boolean" } }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object" }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": { "type": "array" },
        "tls": { "type": "array" }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string" },
        "labels": { "type": "object" }
      }
    },
    "resources": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "priorityClassName": { "type": "string" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "image": { "type": "string" } }
    }
  }
}
